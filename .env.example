# Personal Digital Twin — environment configuration
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# never commit real secrets. All variables are read by `pdt.core.config.Settings`
# with the `PDT_` prefix (see that module for authoritative defaults).

# ---- App ---------------------------------------------------------------
# Runtime environment: dev | prod. Dev-only debug endpoints are gated on this.
PDT_ENV=dev

# Directory where the encrypted DuckDB store, vault salt, and LanceDB vector
# store live. Created automatically by `pdt init`.
PDT_DATA_DIR=.data

# ---- LLM provider --------------------------------------------------------
# One of: mock | openai (see core/llm/registry.py for the supported set).
# Use "mock" for local development/tests with no network calls.
PDT_LLM_PROVIDER=openai
PDT_LLM_MODEL=gpt-4o-mini
# Required when PDT_LLM_PROVIDER is a cloud provider (e.g. openai).
PDT_LLM_API_KEY=
# Optional: point at an OpenAI-compatible endpoint (e.g. a local proxy).
PDT_LLM_BASE_URL=
PDT_EMBEDDING_MODEL=text-embedding-3-small

# ---- Encryption (Argon2id key-derivation parameters) --------------------
# These are deliberately expensive by default. Do not weaken them below the
# `pdt doctor` sanity floor without understanding the tradeoff.
PDT_KDF_MEMORY_KIB=65536
PDT_KDF_TIME_COST=3
PDT_KDF_PARALLELISM=4

# ---- API server ------------------------------------------------------
PDT_API_HOST=127.0.0.1
PDT_API_PORT=8000
